# Atlas 环境变量模板：复制成 .env 再填。这里不写任何真实值。

# ---- Atlas 自己的 PostgreSQL（需要 pgvector 扩展）----
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=20

# ---- 资料库 fabric（文档来源，只读接口 /api/fabric/*）----
FABRIC_API_URL=http://127.0.0.1:8000
FABRIC_READ_TOKEN=
# 逗号分隔的来源 id；留空 = 拉 /api/fabric/sources 列出的全部可读来源
ATLAS_ADMIN_TOKEN=

# ---- LLM（OpenAI 兼容协议）----
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL_NAME=
# 抽取专用 / 精排专用模型（可选，留空复用上面的）
EXTRACTION_LLM_API_KEY=
EXTRACTION_LLM_API_BASE=
EXTRACTION_LLM_MODEL_NAME=
RERANK_LLM_API_KEY=
RERANK_LLM_API_BASE=
RERANK_LLM_MODEL_NAME=

# ---- Embedding（消歧向量检索；维度必须和库里一致，默认 1024）----
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# ---- 抽取任务队列 ----
# memory：进程内（重启丢任务）；redis：需另起 rq worker
TASK_QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
EXTRACTION_CONCURRENCY=3

# ---- WeKnora（审核通过的实体/关系同步到 WeKnora 的 Neo4j）----
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
WEKNORA_KB_ID=
